{
  "name": "xiv-today",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @xiv-today/web dev",
    "build": "pnpm --filter @xiv-today/web build",
    "start": "pnpm --filter @xiv-today/web start",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint && stylelint \"**/*.css\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "db:generate": "pnpm --filter @xiv-today/web db:generate",
    "db:migrate": "pnpm --filter @xiv-today/web db:migrate",
    "db:seed": "pnpm --filter @xiv-today/web db:seed",
    "db:setup": "pnpm --filter @xiv-today/web db:setup"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "next": "16.2.7",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
